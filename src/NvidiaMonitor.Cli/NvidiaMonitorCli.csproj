<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HectorBravo.Nvidia.Test</RootNamespace>
    <!-- Display name is "NvidiaMonitor CLI"; file/assembly names avoid the space. -->
    <AssemblyName>NvidiaMonitorCli</AssemblyName>
    <!-- Release identity: release.ps1 writes releaseinfo.txt (this app's release ZIP
         NAME, e.g. "NvidiaMonitorCli-20261122_2338.zip") next to this project before publish;
         it is embedded below and read at runtime by UpdateService.ReleaseZipName — the
         update check compares it with the newest published cli/ release's asset name.
         Dev builds: no file → empty → never notifies (same rule as the GUI). -->
    <ReleaseInfoFile>$(MSBuildProjectDirectory)\releaseinfo.txt</ReleaseInfoFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(ReleaseInfoFile)" LogicalName="releaseinfo.txt" Condition="Exists('$(ReleaseInfoFile)')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NvmlCore\NvmlCore.csproj" />
    <ProjectReference Include="..\HectorBravo.Nvidia.Contracts\HectorBravo.Nvidia.Contracts.csproj" />
  </ItemGroup>

</Project>
