<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AssemblyName>NvidiaMonitor</AssemblyName>
    <RootNamespace>HectorBravo.Nvidia.Monitor</RootNamespace>
    <!-- NVIDIA eye logo as the exe/taskbar icon (T30, max 256x256). -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded copy of the same logo for the WPF window icon. -->
    <Resource Include="nvidia-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NvmlCore\NvmlCore.csproj" />
    <ProjectReference Include="..\HectorBravo.Nvidia.Contracts\HectorBravo.Nvidia.Contracts.csproj" />
  </ItemGroup>

</Project>
